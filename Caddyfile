# Caddy, our front door: the instance's name in, the app out. It gets the HTTPS certificate for the name on its own.
# NTK_DOMAIN comes from .env, for example your-instance.your-project.projects.jetstream-cloud.org
{$NTK_DOMAIN} {
	# The counts at /metrics are for Prometheus on this machine, not for the internet.
	respond /metrics 404
	reverse_proxy app:8000 {
		# If the app hasn't started to answer within 60 s, stop waiting and tell the user (504 Gateway Timeout).
		# Our slowest normal request (GLiNER on a 30-page PDF) took about 7 s on our instance.
		# Without this, Caddy waits as long as the app does: forever, if it is stuck.
		transport http {
			response_header_timeout 60s
		}
	}
}
