# Copy to .env and edit. Read once at startup: change it, then `docker compose up -d --build`.
# On the instance, pin the image CI built instead of building it (scripts/deploy.sh sets this line):
# APP_IMAGE=ghcr.io/trevoradriaanse/needtoknow:sha-xxxxxxx
# APP_PORT=8000
NTK_DETECTOR=regex            # regex | presidio | gliner | regex+gliner
DETECTOR_EXTRA=               # what the image installs: empty for regex, gliner for gliner or regex+gliner
NTK_MAX_UPLOAD_MB=10
NTK_MAX_PAGES=30
NTK_LOG_LEVEL=INFO
# NTK_DB_PATH=/data/needtoknow.db   # the image sets this; empty turns counting off
# NTK_GLINER_MODEL=urchade/gliner_multi_pii-v1
# NTK_GLINER_THRESHOLD=0.5
